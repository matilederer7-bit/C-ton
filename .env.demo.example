APP_DEPLOYMENT_MODE=demo-preview
HOST=0.0.0.0
# Render injects PORT automatically. Keep 3000 only for local preview runs.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siton
DB_SCHEMA=siton
LOG_LEVEL=info
DEBUG_SQL_LOGGING=0
DEBUG_JOIN_LOGGING=0
DEBUG_SURFACES_ENABLED=1
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret
PAYMENT_PROVIDER=mockpay
PAYMENT_PROVIDER_MODE=mock-backed
PAYMENT_WEBHOOK_PROVIDER=mockpay
# First real buyer-payment adapter (future activation):
