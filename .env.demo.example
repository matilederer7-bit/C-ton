APP_DEPLOYMENT_MODE=demo-preview
HOST=0.0.0.0
# Render injects PORT automatically. Keep 3000 only for local preview runs.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siton
DB_SCHEMA=siton
LOG_LEVEL=info
DEBUG_SQL_LOGGING=0
DEBUG_JOIN_LOGGING=0
DEBUG_SURFACES_ENABLED=1
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret
PAYMENT_PROVIDER=mockpay
PAYMENT_PROVIDER_MODE=mock-backed
PAYMENT_WEBHOOK_PROVIDER=mockpay
# Canonical Stripe Sandbox adapter. Supply values through the deployment secret store only.
# PAYMENT_PROVIDER=stripe
# PAYMENT_PROVIDER_MODE=stripe
# PAYMENT_ENVIRONMENT=sandbox
# PAYMENT_PROVIDER_BASE_URL=https://api.stripe.com
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_PUBLIC_KEY=
# PAYMENT_PROVIDER_TIMEOUT_MS=8000
# PAYMENT_WEBHOOK_PROVIDER=stripe
# PAYMENT_WEBHOOK_SECRET=
# STRIPE_ALLOW_SERVER_SIDE_CARD_TOKENIZATION=0
PAYOUT_PROVIDER=internal-ledger
PAYOUT_PROVIDER_MODE=internal-truth-only
# First real invoice adapter (future activation):
# INVOICE_PROVIDER=morning
# INVOICE_PROVIDER_MODE=real
# INVOICE_PROVIDER_BASE_URL=https://api.greeninvoice.co.il/api/v1
# INVOICE_PROVIDER_API_KEY=invoice_provider_key
# INVOICE_PROVIDER_BEARER_TOKEN=invoice_provider_access_token
# INVOICE_WEBHOOK_SECRET=invoice_webhook_secret
NOTIFICATION_PROVIDER=log-only

# External private object storage (S3-compatible). Set via deployment secrets; do not commit values.
# STORAGE_ADAPTER=object
# OBJECT_STORAGE_ENDPOINT=https://s3-compatible-provider.example
# OBJECT_STORAGE_REGION=provider-region
# OBJECT_STORAGE_BUCKET=private-bucket-name
# OBJECT_STORAGE_ACCESS_KEY_ID=deployment-secret
# OBJECT_STORAGE_SECRET_ACCESS_KEY=deployment-secret
# OBJECT_STORAGE_FORCE_PATH_STYLE=0
# OBJECT_STORAGE_PREFIX=sandbox
# OBJECT_STORAGE_TIMEOUT_MS=5000
# OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
