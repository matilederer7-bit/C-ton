# PAYMENT_WEBHOOK_PROVIDER=stripe
# PAYMENT_WEBHOOK_SECRET=whsec_xxx
# STRIPE_ALLOW_SERVER_SIDE_CARD_TOKENIZATION=0
PAYOUT_PROVIDER=internal-ledger
PAYOUT_PROVIDER_MODE=internal-truth-only
