{
  "name": "siton-worker-tick",
  "entry": "index.ts",
  "automations": [
    {
      "name": "Siton canonical worker tick",
      "description": "Runs bounded Base44-owned background batches. The automation creator must retain admin role.",
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "*/5 * * * *",
      "ends_type": "never",
      "function_args": {
        "source": "base44-automation",
        "limit": 20
      },
      "is_active": true
    }
  ]
}
