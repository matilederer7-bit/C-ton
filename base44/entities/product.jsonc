{
  "name": "Product",
  "description": "Reusable seller-owned commercial identity. Deals take an immutable buyer-visible snapshot; this entity owns no state, inventory, or money truth.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "product_id": { "type": "string", "format": "uuid" },
    "seller_account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "seller_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "short_description": { "type": "string", "maxLength": 200, "default": "" },
    "long_description": { "type": "string", "maxLength": 4000, "default": "" },
    "product_type": { "type": "string", "enum": ["physical_product", "voucher", "ticket", "service"] },
    "category": { "type": "string", "maxLength": 160, "default": "" },
    "type_attributes": { "type": "object", "default": {} },
    "fulfillment_defaults": { "type": "object", "default": {} },
    "image_refs": { "type": "array", "items": { "type": "string", "maxLength": 160 }, "default": [] },
    "status": { "type": "string", "enum": ["active", "archived"], "default": "active" },
    "revision": { "type": "integer", "minimum": 1, "default": 1 }
  },
  "required": ["product_id", "seller_account_id", "seller_user_id", "name", "short_description", "long_description", "product_type", "category", "type_attributes", "fulfillment_defaults", "image_refs", "status", "revision"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.seller_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

