{
  "name": "siton-reservation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test:concurrency": "tsx tests/concurrency.ts",
    "test:close": "tsx tests/close.ts",
    "test:saga": "tsx tests/saga-recovery.ts",
