    "test:target": "tsx tests/target-reached.ts"
  },
  "dependencies": {
    "fastify": "^5.7.4",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
